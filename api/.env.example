# Salin ke .env (jangan di-commit).
DATABASE_URL=sqlite://layan.db
BIND=127.0.0.1:8080
# 1 kalau sudah di belakang HTTPS
COOKIE_SECURE=0

# Password untuk semua akun demo, dipakai saat seed pertama kali.
# Login pakai NIM (mis. 245150200111001) atau email (mis. sari@staf.layan.test).
SEED_PASSWORD=layan-demo-2026

# Akun tetap (juri, admin, teknisi) dengan email + password masing-masing, dipakai saat seed pertama kali
# kalau filenya ada; SEED_PASSWORD di atas lalu tidak dipakai. Format: accounts.example.json. Jangan di-commit.
ACCOUNTS_FILE=accounts.json

# Folder lampiran upload
UPLOAD_DIR=uploads

# Folder rilis App Android (layan.apk + latest.json), diisi deploy/release-android.sh
APP_DIR=releases

# LLM format OpenAI (Gemini, DeepSeek, dll). Kosongkan LLM_API_KEY untuk agent tiruan (mock).
# Gemini: https://aistudio.google.com/apikey
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
